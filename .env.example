# 玉珍健身前端 - 环境变量模板
# Vue PWA Frontend Environment Template
# 更新日期：2026-01-18
#
# 使用说明：
# 1. 复制此文件为 .env（本地开发）或 .env.local（本地覆盖）
# 2. 根据环境修改配置值
# 3. 所有VITE_开头的变量会在构建时注入到前端代码
# 4. 敏感信息不应放在此文件中（前端代码可被查看）

# ==================== API配置 ====================

# 后端API地址
# 本地开发：http://localhost:8000/api
# 生产环境：https://api.yuzhen-fitness.cn/api
VITE_API_BASE_URL=http://localhost:8000/api

# DAML-RAG AI服务地址
# 本地开发：http://localhost:8000/ai（通过PHP后端代理）
# 生产环境：https://ai.yuzhen-fitness.cn/api
VITE_DAML_RAG_API_URL=http://localhost:8000/ai

# ==================== CDN配置（可选）====================

# CDN域名（用于静态资源加速）
# VITE_CDN_URL=

# ==================== 应用配置 ====================

# 应用名称
VITE_APP_NAME=玉珍健身

# 应用版本
VITE_APP_VERSION=1.0.0-dev

# 应用环境 (development, staging, production)
VITE_APP_ENV=development

# 应用域名
VITE_APP_DOMAIN=localhost

# ==================== 功能开关 ====================

# 启用PWA（本地开发可关闭）
VITE_ENABLE_PWA=false

# 启用Service Worker（本地开发可关闭）
VITE_ENABLE_SW=false

# 启用性能监控
VITE_ENABLE_PERFORMANCE_MONITORING=false

# 启用错误追踪
VITE_ENABLE_ERROR_TRACKING=false

# ==================== 第三方服务（可选）====================

# Sentry错误追踪DSN
# VITE_SENTRY_DSN=

# Google Analytics ID
# VITE_GA_ID=

# 百度统计ID
# VITE_BAIDU_ANALYTICS_ID=

# ==================== 支付配置（可选）====================

# 微信支付AppID
# VITE_WECHAT_PAY_APP_ID=

# 支付宝AppID
# VITE_ALIPAY_APP_ID=

# ==================== 其他配置 ====================

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=30000

# 上传文件大小限制（MB）
VITE_MAX_UPLOAD_SIZE=10

# 是否启用调试模式
VITE_DEBUG=true

# ==================== 安全配置说明 ====================
#
# 注意：前端环境变量会被打包到客户端代码中，
# 因此不应包含任何敏感信息（如API密钥、密码等）。
#
# 以下类型的信息不应放在前端环境变量中：
# - 数据库密码
# - API密钥（后端API密钥）
# - JWT密钥
# - 加密密钥
# - 内部服务Token
#
# 如需使用敏感API，应通过后端代理访问。
