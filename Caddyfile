:8080 {
	root * /usr/share/caddy

	# 默认：所有响应不缓存（保护SPA fallback的index.html）
	header Cache-Control "no-cache, no-store, must-revalidate"

	# 静态资源（带hash文件名）- 覆盖为长期缓存
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# SW 和 manifest 必须不缓存（确保浏览器每次检查更新）
	@swfiles path /sw.js /manifest.json /workbox-*.js
	header @swfiles Cache-Control "no-cache, no-store, must-revalidate"

	# 尝试文件 → SPA fallback
	try_files {path} /index.html

	file_server
}
