# 本地开发环境配置（默认）
# 玉珍健身 - Local Development Environment Configuration
# 更新日期：2026-01-08
# 
# 说明：
# - .env 用于本地开发（默认加载）
# - .env.production 用于生产构建（npm run build时加载）
# - .env.local 用于本地覆盖（不提交到Git）

# ==================== API配置 ====================

# 后端API地址（本地Docker）
VITE_API_BASE_URL=http://localhost:8000/api

# DAML-RAG AI服务地址（通过PHP后端代理）
VITE_DAML_RAG_API_URL=http://localhost:8000/ai

# ==================== 应用配置 ====================

# 应用名称
VITE_APP_NAME=玉珍健身

# 应用版本
VITE_APP_VERSION=1.0.0-dev

# 应用环境
VITE_APP_ENV=development

# 应用域名
VITE_APP_DOMAIN=localhost

# ==================== 功能开关 ====================

# 启用PWA（本地开发可关闭）
VITE_ENABLE_PWA=false

# 启用Service Worker（本地开发可关闭）
VITE_ENABLE_SW=false

# 启用性能监控
VITE_ENABLE_PERFORMANCE_MONITORING=false

# 启用错误追踪
VITE_ENABLE_ERROR_TRACKING=false

# ==================== 其他配置 ====================

# 超时配置（毫秒）
VITE_REQUEST_TIMEOUT=30000

# 上传文件大小限制（MB）
VITE_MAX_UPLOAD_SIZE=10

# 是否启用调试模式
VITE_DEBUG=true
